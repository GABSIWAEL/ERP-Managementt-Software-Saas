# TechNova ERP - Docker Environment Configuration
# Copy this file to .env and modify values as needed

# ============================================
# Email Configuration (For Auto Employee Credentials)
# ============================================
# RECOMMENDED: Use Gmail with App Password
# Get App Password: https://myaccount.google.com/apppasswords
# Requires 2FA enabled on your Google Account

MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=noreply@company-erp.com

# ============================================
# PostgreSQL Database Configuration
# ============================================
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_password_secure_change_in_prod
POSTGRES_DB=erp_system
POSTGRES_PORT=5432

# ============================================
# Spring Boot Backend Configuration
# ============================================
BACKEND_PORT=8080

# ============================================
# React Frontend Configuration
# ============================================
FRONTEND_PORT=3000

# ============================================
# Additional Settings
# ============================================

# Timezone
TZ=UTC

# Database initialization arguments
# POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=en_US.UTF-8

# Java VM Options (for backend)
# JAVA_OPTS=-Xmx512m -Xms256m -XX:+UseG1GC

# Spring Profiles (for environment-specific config)
# SPRING_PROFILES_ACTIVE=docker

# Notes:
# - Email configuration is REQUIRED for automatic credential emails
# - For production, use strong passwords (min 20 chars)
# - For production, set timezone to your region
# - For Mac/Linux, database port is on localhost:5432
# - For Windows, database port is on localhost:5432 via Docker network
# - NEVER commit .env file with real credentials to git!

